{
  "name": "fcpteloper",
  "productName": "FCPTeloper",
  "version": "0.0.1",
  "private": true,
  "description": "複数動画の文字起こしを Electron アプリでレビュー・AI修正し、Final Cut Pro 向けの FCPXML を生成するパイプライン",
  "main": ".vite/build/main.js",
  "author": {
    "name": "Junpei Wada",
    "email": "junpeiwada@gmail.com"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "eslint --ext .ts,.tsx .",
    "sdk:smoke": "tsx scripts/sdk-smoke.ts",
    "transcript:generate": "tsx bin/transcript-generate.ts",
    "transcript:validate": "tsx bin/transcript-validate.ts",
    "video:probe": "tsx bin/video-probe.ts",
    "fcpxml:build": "tsx bin/fcpxml-build.ts",
    "fcpxml:diff": "tsx scripts/diff-fcpxml.ts",
    "logs:tail": "tsx bin/logs-tail.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.87",
    "electron-squirrel-startup": "^1.0.1",
    "fast-xml-parser": "^5.7.3",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
    "@electron-forge/plugin-fuses": "^7.11.1",
    "@electron-forge/plugin-vite": "^7.11.1",
    "@electron/fuses": "^1.8.0",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "electron": "42.0.1",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.0"
  }
}
